# Copy this file to backend/.env and fill in your own values. Never commit .env.
GEMINI_API_KEY=your-key-from-aistudio.google.com
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
# Similarity needed to merge a new vocabulary term into an existing one
VOCAB_MERGE_THRESHOLD=0.88

# Neo4j AuraDB gives you these on creation (neo4j+s://...). Local Docker: bolt://localhost:7687
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-password

# Optional API settings (see api/README.md)
# CORS_ORIGINS=*
# API_MAX_CARDS=6
