# Copy this file to backend/.env and fill in your own values. Never commit .env.
GEMINI_API_KEY=your-key-from-aistudio.google.com
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
# Similarity needed to merge a new vocabulary term into an existing one
VOCAB_MERGE_THRESHOLD=0.88

# Neo4j AuraDB gives you these on creation (neo4j+s://...). Local Docker: bolt://localhost:7687
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-password

# Optional API settings (see api/README.md)
# Stronger model for chat answers (empty = GEMINI_MODEL). Use the non-lite Flash model name from AI Studio.
# API_GEMINI_MODEL=
# CORS_ORIGINS=*
# API_MAX_CARDS=6
# API_GEMINI_RETRIES=8
# API_GEMINI_MAX_WAIT=30
# Name of the app (shown as the source of knowledge from feedback notes)
# APP_NAME=Evisa
# Until login exists: who gives feedback (the frontend can send user_name / user_role instead)
# DEMO_USER_NAME=Erkki Expert
# DEMO_USER_ROLE=Network Expert
