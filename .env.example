# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=your-key-from-aistudio.google.com
# Check AI Studio for the current Flash model name and put it here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
# Similarity needed to merge a new term into an existing one (tune after a first run)
VOCAB_MERGE_THRESHOLD=0.88

# Neo4j AuraDB Free gives you these on creation (neo4j+s://...). Local Docker: bolt://localhost:7687
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-password
